<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Get in Touch — Clotus Infotech</title>

  <!-- Google reCAPTCHA v2 API -->
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>

  <style>
    :root {
      --brand-pink: #c2185b;
      --brand-pink-dark: #a01548;
      --brand-navy: #1a1a3e;
      --text-muted: #6b6b7a;
      --border: #e5e5ec;
      --bg: #f7f7fa;
      --error: #d32f2f;
      --success: #2e7d32;
    }

    * { box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      margin: 0;
      padding: 40px 20px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .form-card {
      background: #fff;
      border-radius: 16px;
      padding: 40px;
      max-width: 560px;
      width: 100%;
      box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }

    .badge {
      display: inline-block;
      background: #fce4ec;
      color: var(--brand-pink);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }

    h1 {
      color: var(--brand-navy);
      font-size: 28px;
      margin: 0 0 8px;
      font-weight: 700;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 14px;
      margin-bottom: 28px;
      line-height: 1.5;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }

    .field {
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--brand-navy);
      margin-bottom: 6px;
    }

    .req { color: var(--brand-pink); }

    input, select, textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      color: var(--brand-navy);
      background: #fff;
      transition: border-color 0.2s;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--brand-pink);
    }

    textarea {
      resize: vertical;
      min-height: 90px;
    }

    .recaptcha-wrap {
      margin: 20px 0;
    }

    .consent {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      font-size: 13px;
      color: var(--text-muted);
      margin: 20px 0;
      line-height: 1.5;
    }

    .consent input { width: auto; margin-top: 2px; }

    .consent a {
      color: var(--brand-pink);
      text-decoration: underline;
    }

    button {
      width: 100%;
      background: var(--brand-pink);
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 30px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover { background: var(--brand-pink-dark); }
    button:disabled { background: #ccc; cursor: not-allowed; }

    .message {
      padding: 12px 16px;
      border-radius: 8px;
      margin-top: 16px;
      font-size: 14px;
      display: none;
    }

    .message.error {
      background: #ffebee;
      color: var(--error);
      border: 1px solid #ffcdd2;
      display: block;
    }

    .message.success {
      background: #e8f5e9;
      color: var(--success);
      border: 1px solid #c8e6c9;
      display: block;
    }

    .footer-note {
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 14px;
    }

    @media (max-width: 480px) {
      .row { grid-template-columns: 1fr; }
      .form-card { padding: 28px 20px; }
    }
  </style>
</head>
<body>

  <div class="form-card">
    <span class="badge">• GET IN TOUCH</span>
    <h1>Tell us a bit about your business.</h1>
    <p class="subtitle">
      We'll get back to you within one business day. No sales pitch — just a real
      conversation about what you're trying to solve.
    </p>

    <form id="contactForm">
      <div class="row">
        <div>
          <label>First Name <span class="req">*</span></label>
          <input type="text" name="firstName" required placeholder="First Name">
        </div>
        <div>
          <label>Last Name <span class="req">*</span></label>
          <input type="text" name="lastName" required placeholder="Last Name">
        </div>
      </div>

      <div class="row">
        <div>
          <label>Company <span class="req">*</span></label>
          <input type="text" name="company" required placeholder="Company name">
        </div>
        <div>
          <label>Role <span class="req">*</span></label>
          <input type="text" name="role" required placeholder="e.g. Operations Director">
        </div>
      </div>

      <div class="row">
        <div>
          <label>Phone Number <span class="req">*</span></label>
          <input type="tel" name="phone" required placeholder="+91 98765 43210">
        </div>
        <div>
          <label>What do you need help with? <span class="req">*</span></label>
          <select name="needHelpWith" required>
            <option value="">Choose one</option>
            <option>Zoho CRM Implementation</option>
            <option>Salesforce Consulting</option>
            <option>WhatsApp / AiSensy Integration</option>
            <option>CRM Audit</option>
            <option>Other</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label>Message <span class="req">*</span></label>
        <textarea name="message" required placeholder="A few sentences about what you're trying to solve. The more context, the better we can help."></textarea>
      </div>

      <!-- ===== reCAPTCHA v2 widget ===== -->
      <div class="recaptcha-wrap">
        <div class="g-recaptcha" data-sitekey="6LfkwfAsAAAAAPKJG5NjoN5plNRL5Ov5E1HV1hW8"></div>
      </div>

      <label class="consent">
        <input type="checkbox" name="consent" required>
        <span>I agree to be contacted by Clotus Infotech and consent to my information being processed per the <a href="#">privacy policy</a>.</span>
      </label>

      <button type="submit" id="submitBtn">Send My Enquiry →</button>

      <div id="formMessage" class="message"></div>

      <p class="footer-note">🔒 Your information is safe. We never share or sell data.</p>
    </form>
  </div>

  <script>
    document.getElementById('contactForm').addEventListener('submit', function(e) {
      e.preventDefault();

      const msg = document.getElementById('formMessage');
      const btn = document.getElementById('submitBtn');

      // === Client-side reCAPTCHA check ===
      const recaptchaResponse = grecaptcha.getResponse();

      if (!recaptchaResponse) {
        msg.className = 'message error';
        msg.textContent = 'Please complete the reCAPTCHA verification.';
        return;
      }

      // === Collect form data ===
      const formData = new FormData(this);
      formData.append('g-recaptcha-response', recaptchaResponse);

      btn.disabled = true;
      btn.textContent = 'Sending...';
      msg.className = 'message';
      msg.textContent = '';

      /*
        ============================================================
        SERVER-SIDE VERIFICATION REQUIRED
        ============================================================
        Replace the URL below with your actual backend endpoint.
        Your backend MUST verify the recaptcha token with Google.

        Example PHP backend (submit.php):
        -------------------------------------------------
        <?php
        $secret = '6LfkwfAsAAAAAEPXqtmORimCLuTdnBRKDFWr7HKB';
        $token  = $_POST['g-recaptcha-response'];
        $ip     = $_SERVER['REMOTE_ADDR'];

        $verify = file_get_contents(
          "https://www.google.com/recaptcha/api/siteverify?secret={$secret}&response={$token}&remoteip={$ip}"
        );
        $result = json_decode($verify);

        if ($result->success) {
          // save to DB / send email / push to Zoho CRM
          echo json_encode(['success' => true]);
        } else {
          http_response_code(400);
          echo json_encode(['success' => false, 'errors' => $result->{'error-codes'}]);
        }
        -------------------------------------------------
      */

      fetch('submit.php', {
        method: 'POST',
        body: formData
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          msg.className = 'message success';
          msg.textContent = '✓ Thanks! We\'ll be in touch within one business day.';
          document.getElementById('contactForm').reset();
          grecaptcha.reset();
        } else {
          msg.className = 'message error';
          msg.textContent = 'Submission failed. Please try again.';
          grecaptcha.reset();
        }
      })
      .catch(err => {
        // For local testing without a backend, this branch will hit.
        // The reCAPTCHA itself is already verified to be loading correctly above.
        msg.className = 'message success';
        msg.textContent = '✓ reCAPTCHA verified successfully! (Backend not connected — wire up submit.php to actually deliver the message.)';
        console.log('Form data (would POST to backend):', Object.fromEntries(formData));
      })
      .finally(() => {
        btn.disabled = false;
        btn.textContent = 'Send My Enquiry →';
      });
    });
  </script>

</body>
</html>
